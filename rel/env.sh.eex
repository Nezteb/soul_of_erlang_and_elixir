#!/bin/sh

# Old config:
# export RELEASE_DISTRIBUTION=name
# export RELEASE_NODE="my_system_1@127.0.0.1"

# https://hexdocs.pm/mix/Mix.Tasks.Release.html#module-customization-and-configuration-summary
# https://hexdocs.pm/phoenix/releases.html#dns-discovery

# # Set the release to load code on demand (interactive) instead of preloading (embedded).
# export RELEASE_MODE=interactive
export ERL_EPMD_PORT=4369

# # Set the release to work across nodes.
# # RELEASE_DISTRIBUTION must be "sname" (local), "name" (distributed) or "none".
export RELEASE_DISTRIBUTION=name
# Use the ports 4370-4372 for nodes to communicate.
export ERL_AFLAGS="-kernel inet_dist_listen_min 4370 inet_dist_listen_max 4372"
export RELEASE_NAME=rpg

# TODO: Finish
# https://hexdocs.pm/phoenix/releases.html#dns-discovery
DEFAULT_RELEASE_NODE="$RELEASE_NAME-${PLATFORM_DEPLOYMENT_SHA}@${PLATFORM_DEPLOYMENT_IP}"
export RELEASE_NODE="${RELEASE_NODE:-$DEFAULT_RELEASE_NODE}"

# ???
# TODO:
# Given container names: tdd_node_a, tdd_node_b, tdd_node_c ???
# How to give each a DNS name in Docker compose?
export DNS_CLUSTER_QUERY="host.docker.internal"

# TODO: Finish setting up clustering https://hexdocs.pm/phoenix/releases.html#clustering
