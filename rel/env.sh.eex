#!/bin/sh

# TODO: Get release config + docker-compose env vars for clustering working
# Docs:
# - Distributed Erlang docs: https://www.erlang.org/doc/system/distributed.html
# - Mix release configuration: https://hexdocs.pm/mix/Mix.Tasks.Release.html#module-customization-and-configuration-summary
# - Phoenix releases clustering: https://hexdocs.pm/phoenix/releases.html#clustering
# - Phoenix releases DNS discovery: https://hexdocs.pm/phoenix/releases.html#dns-discovery

export RELEASE_DISTRIBUTION="name"
export RELEASE_NAME="my_system"

# export RELEASE_NODE="my_system_1@127.0.0.1"
export RELEASE_NODE=${RELEASE_NODE:-"$RELEASE_NAME@$(hostname)"}
export RELEASE_COOKIE=${RELEASE_COOKIE:-"my_secure_cookie"}

export ERL_EPMD_PORT=4369

# Use the ports 4370-4372 for nodes to communicate.
export ERL_AFLAGS="-proto_dist inet_tcp -kernel inet_dist_listen_min 4370 inet_dist_listen_max 4372"
export DNS_CLUSTER_QUERY="host.docker.internal"
